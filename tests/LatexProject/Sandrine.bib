	doi = {10.1016/j.jappmathmech.2005.01.001},
	journal = {Journal of Applied Mathematics an Mechanics},
	pages = {1-11},
	title = {A Generalization of the Method of Averaging for the Optimal Control on Nonlinear Oscillations},
